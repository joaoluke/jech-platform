---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNavbar from "../components/SiteNavbar.astro";

const description =
  "Teste a linguagem Jech no navegador com o playground oficial em WebAssembly. Escreva, execute e aprenda em tempo real.";
---

<BaseLayout
  title="Playground - Jech"
  description={description}
  canonical="https://www.jech-lang.org/playground"
>
  <Fragment slot="head">
    <script is:inline src="/js/playground/wasm-loader.js"></script>
    <style>
      .playground-status {
        padding: 0.75rem 2rem;
        font-size: 0.875rem;
        text-align: center;
        font-weight: 500;
        transition: all 0.3s;
      }

      .playground-status.ready {
        background: rgba(34, 197, 94, 0.15);
        color: #86efac;
        border-top: 1px solid rgba(34, 197, 94, 0.2);
      }

      .playground-status.error {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border-top: 1px solid rgba(239, 68, 68, 0.2);
      }

      .playground-status.running {
        background: rgba(181, 58, 46, 0.15);
        color: #d4695f;
        border-top: 1px solid rgba(181, 58, 46, 0.2);
      }
    </style>
  </Fragment>

  <SiteNavbar active="playground" />

  <div class="playground-container flex flex-col h-[calc(100vh-80px)] bg-bg-dark py-8 px-0">
    <div class="playground-header px-8 pb-6 flex justify-between items-center flex-wrap gap-4">
      <h1
        class="playground-title text-3xl font-bold bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent"
        data-i18n="playground.title">Jech Playground</h1
      >
      <div class="playground-controls flex gap-4 flex-wrap">
        <button
          id="runBtn"
          class="playground-btn rounded p-4 btn-primary disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none disabled:shadow-none"
          disabled
        >
          <span class="run-icon">▶</span> <span data-i18n="playground.run">Executar</span> (Ctrl+Enter)
        </button>
        <button
          id="clearBtn"
          class="playground-btn rounded p-4 btn-secondary disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none disabled:shadow-none"
          disabled
        >
          <span class="clear-icon">🗑️</span> <span data-i18n="playground.clear">Limpar</span>
        </button>
      </div>
    </div>

    <div
      class="playground-main flex-1 grid grid-cols-1 md:grid-cols-2 gap-[1px] bg-bg-dark-3/30 overflow-hidden rounded-lg mx-8 shadow-2xl"
    >
      <div class="playground-panel bg-bg-dark-2 flex flex-col h-full overflow-hidden">
        <div
          class="playground-panel-header bg-bg-dark-3 px-6 py-4 font-semibold border-b border-bg-dark-3 flex items-center gap-2"
        >
          <span>📝</span> <span data-i18n="playground.sourceCode">Código Fonte</span>
        </div>
        <div class="playground-panel-content flex-1 overflow-auto relative">
          <textarea
            id="editor"
            class="w-full h-full font-mono text-sm leading-normal bg-transparent text-text-secondary p-6 border-none resize-none outline-none"
            spellcheck="false"
            placeholder="Digite seu código Jech aqui..."
            data-i18n-placeholder="playground.editorPlaceholder"
          ></textarea>
        </div>
      </div>

      <div class="playground-panel bg-bg-dark-2 flex flex-col h-full overflow-hidden border-l border-bg-dark-3/20">
        <div
          class="playground-panel-header bg-bg-dark-3 px-6 py-4 font-semibold border-b border-bg-dark-3 flex items-center gap-2"
        >
          <span>📤</span> <span data-i18n="playground.output">Saída</span>
        </div>
        <div class="playground-panel-content flex-1 overflow-auto relative">
          <pre
            id="output"
            class="p-6 font-mono text-sm white-space-pre-wrap text-success leading-normal min-h-full box-border empty:text-text-muted empty:italic"
            data-i18n="playground.outputPlaceholder"
          >A saída do seu código aparecerá aqui...</pre
          >
        </div>
      </div>
    </div>

    <div
      class="playground-examples px-8 py-6 bg-bg-dark-2 border-t border-bg-dark-3 flex gap-4 flex-wrap items-center mt-auto"
    >
      <span class="playground-examples-label text-sm font-medium text-text-muted" data-i18n="playground.examples"
        >Exemplos:</span
      >
      <button
        class="example-btn bg-bg-dark-3 text-text-secondary px-4 py-2 border border-bg-dark-3 rounded-md text-sm cursor-pointer transition-all hover:bg-primary hover:text-white hover:border-primary"
        onclick="loadExample('hello')"
        data-i18n="playground.exampleHello"
      >
        👋 Olá Mundo
      </button>
      <button
        class="example-btn bg-bg-dark-3 text-text-secondary px-4 py-2 border border-bg-dark-3 rounded-md text-sm cursor-pointer transition-all hover:bg-primary hover:text-white hover:border-primary"
        onclick="loadExample('variables')"
        data-i18n="playground.exampleVariables"
      >
        🔢 Variáveis
      </button>
      <button
        class="example-btn bg-bg-dark-3 text-text-secondary px-4 py-2 border border-bg-dark-3 rounded-md text-sm cursor-pointer transition-all hover:bg-primary hover:text-white hover:border-primary"
        onclick="loadExample('conditionals')"
        data-i18n="playground.exampleConditionals"
      >
        🔀 Condicionais
      </button>
    </div>

    <div
      id="status"
      class="playground-status border-t border-bg-dark-3/30 bg-bg-dark-2 text-text-muted"
      data-i18n="playground.status.initializing"
    >
      <span
        class="loader inline-block w-4 h-4 border-2 border-white/30 rounded-full border-t-white animate-spin mr-2 align-middle"
      ></span>
      Inicializando o interpretador Jech...
    </div>
  </div>

  <script is:inline>
    const examples = {
      hello: 'say("👋 Olá, Mundo!");\n',
      variables:
        '// Variáveis e tipos básicos\nkeep nome = "Jech";\n\n// Concatenação de strings\nsay("Bem-vindo ao " + nome);\n\n// Operações matemáticas\nkeep x = 10;\nkeep y = 5;\nkeep soma = x + y;\n\nsay(soma);',
      conditionals:
        '// Estruturas condicionais\nkeep idade = 20;\n\nwhen (idade > 18) {\n  say("Você é maior de idade!");\n} else {\n  say("Você é menor de idade!");\n}\n'
      // loops: '// Loops\nkeep i = 0;\n\n// Loop while\nwhile (i < 5) {\n  say("Contagem: " + i);\n  i = i + 1;\n}\n\n// Loop for\nfor (keep j = 0; j < 3; j = j + 1) {\n  say("Iteração: " + j);\n}',
      // functions: '// Funções\ndo saudacao(nome) {\n  say("Olá, " + nome + "!");\n  return "Saudação enviada para " + nome;\n}\n\n// Chamando a função\nkeep mensagem = saudacao("Visitante");\nsay("Retorno: " + mensagem);'
    };

    const editor = document.getElementById("editor");
    const output = document.getElementById("output");
    const runBtn = document.getElementById("runBtn");
    const clearBtn = document.getElementById("clearBtn");
    const statusElement = document.querySelector(".playground-status");

    let isReady = false;

    async function initJech() {
      try {
        updateStatus("⏳ " + I18n.t('playground.status.initializing'));

        JechWASM.setOutputCallback((text) => {
          output.textContent = text;
          output.classList.remove("empty");
          output.scrollTop = output.scrollHeight;
        });

        await JechWASM.init();

        if (!JechWASM.isInitialized()) {
          throw new Error("Falha ao inicializar o interpretador Jech");
        }

        const version = await JechWASM.getVersion();
        console.log(`Jech ${version} ${I18n.t('playground.status.ready').replace('{version}', version)}`);

        isReady = true;
        runBtn.disabled = false;
        clearBtn.disabled = false;
        updateStatus(`✅ ${I18n.t('playground.status.ready', { version })}`, "ready");

        loadExample("hello");
      } catch (error) {
        console.error("Erro ao inicializar o interpretador Jech:", error);
        const errorMessage = I18n.t('playground.status.errorInit', { error: error.message });
        updateStatus(`❌ ${errorMessage}`, "error");
        appendOutput(`Erro crítico: ${error.message}`, true);
      }
    }

    function loadExample(name) {
      if (examples[name]) {
        editor.value = examples[name];
        editor.scrollTop = 0;

        updateStatus(
          `✅ ${I18n.t('playground.status.exampleLoaded', { name: name.replace(/([A-Z])/g, " $1").trim() })}`
        );

        editor.focus();
        updateEditorHeight();
      } else {
        updateStatus(`❌ ${I18n.t('playground.status.exampleNotFound')}`, "error");
      }
    }

    function updateStatus(message, type = "") {
      statusElement.textContent = message;
      statusElement.className =
        "playground-status" + (type ? ` ${type}` : "");
    }

    async function runCode() {
      if (!isReady) {
        updateStatus(
          `❌ ${I18n.t('playground.status.notReady')}`,
          "error"
        );
        return;
      }

      const code = editor.value.trim();
      if (!code) {
        updateStatus(`❌ ${I18n.t('playground.status.noCode')}`, "error");
        return;
      }

      clearOutput();

      const codePreview = document.createElement("div");
      codePreview.className = "code-preview";
      codePreview.innerHTML = `
          <div class="code-preview-header">🚀 ${I18n.t('playground.status.executing')}</div>
          <div class="code-separator">-------------------</div>
          <pre>${code.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>
          <div class="code-separator">-------------------</div>
        `;
      output.appendChild(codePreview);

      const startTime = performance.now();
      updateStatus(`⚡ ${I18n.t('playground.status.running')}`, "running");

      try {
        const result = await JechWASM.execute(code);
        const executionTime = (
          (performance.now() - startTime) /
          1000
        ).toFixed(2);

        if (result) {
          updateStatus(
            `✅ ${I18n.t('playground.status.success', { time: executionTime })}`,
            "success"
          );
        } else {
          updateStatus(
            `❌ ${I18n.t('playground.status.error')} (${executionTime}s)`,
            "error"
          );
        }
      } catch (error) {
        console.error("Erro ao executar código:", error);
        const errorMessage = error.message || "Erro desconhecido";
        appendOutput(`❌ Erro: ${errorMessage}`, true);
        updateStatus(`❌ ${I18n.t('playground.status.error')}`, "error");
      }
    }

    function clearOutput() {
      output.textContent = I18n.t('playground.outputPlaceholder');
      JechWASM.clearOutput();
    }

    function appendOutput(text, isError = false) {
      if (output.classList.contains("empty")) {
        output.textContent = "";
        output.className = "";
      }

      const line = document.createElement("div");
      line.className = isError ? "output-line error" : "output-line";

      const lines = text.split("\n");
      lines.forEach((lineText, index) => {
        if (index > 0) {
          output.appendChild(document.createElement("br"));
        }
        if (lineText) {
          const textNode = document.createTextNode(lineText);
          output.appendChild(textNode);
        }
      });

      output.scrollTop = output.scrollHeight;
    }

    runBtn.addEventListener("click", runCode);
    clearBtn.addEventListener("click", clearOutput);

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
        e.preventDefault();
        runCode();
      }
    });

    function updateEditorHeight() {
      editor.style.height = "auto";
      editor.style.height = editor.scrollHeight + "px";
    }

    function initEditor() {
      editor.addEventListener("input", updateEditorHeight);
      window.addEventListener("resize", updateEditorHeight);
      updateEditorHeight();

      initJech();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initEditor);
    } else {
      initEditor();
    }
  </script>
  <script is:inline src="/js/i18n/translations.js"></script>
  <script is:inline src="/js/i18n/i18n.js"></script>
</BaseLayout>
