---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página não encontrada - Jech"
  description="A página solicitada não foi encontrada no site do Jech."
  canonical="https://www.jech-lang.org/404"
  robots="noindex, follow"
>
  <div
    class="min-h-[80vh] flex flex-col items-center justify-center text-center px-8 py-16"
  >
    <h1
      class="text-[8rem] font-bold leading-none bg-linear-to-br from-primary to-accent bg-clip-text text-transparent mb-0"
    >
      404
    </h1>
    <p class="text-2xl text-text-secondary my-4">Página não encontrada</p>
    <p class="text-text-muted mb-8 max-w-md">
      A página que você está procurando não existe ou foi movida.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="/" class="btn btn-primary">Voltar ao Início</a>
      <a href="/playground" class="btn btn-secondary">Ir para o Playground</a>
    </div>
  </div>
</BaseLayout>
